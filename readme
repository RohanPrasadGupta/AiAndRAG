```
AiAndRAG/
├── docker-compose.yml          # Neo4j + PostgreSQL services
├── documents.txt               # knowledge base (AI and skills)
├── chroma_db/                  # persisted vector store
├── neo4j_data/                 # persisted graph database
├── venv/                       # Python virtual environment
│
├── hello_llm.py                # Phase 1 Step 1
├── prompt_template.py          # Phase 1 Step 2
├── chunk_data.py               # Phase 1 Step 3
├── embeddings.py               # Phase 1 Steps 4-6
├── rag.py                      # Phase 1 Step 7
│
├── phase2/
│   ├── rag_with_memory.py      # Phase 2 Step 1
│   ├── rag_compression.py      # Phase 2 Step 2
